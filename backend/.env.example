# ==========================
# WhatsHybrid - .env.example (FULL MODE)
# ==========================
#
# ✅ Você pode preencher manualmente (sem expor credenciais no chat).
# ✅ Onde tiver "COLE_..._AQUI" ou "SEU_..._AQUI" substitua pelo valor real.
#
# Dica: copie este arquivo para .env
#

# --- Server
PORT=4000
HOST=0.0.0.0
JSON_LIMIT=50mb

# --- Legacy DB (Prisma/SQLite) usado pela extensão
DATABASE_URL="file:./data.db"

# --- Segurança / Extensão
EXTENSION_SHARED_KEY="COLE_SUA_EXTENSION_SHARED_KEY_AQUI"
ADMIN_TOKEN="COLE_SEU_ADMIN_TOKEN_AQUI"

# Chave mestre para validação de licenças (HMAC)
LICENSE_MASTER_KEY="COLE_SUA_LICENSE_MASTER_KEY_AQUI"

# Chave de criptografia (64 chars hex) para armazenar segredos no banco (AppSetting)
# Exemplo para gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY="COLE_SUA_APP_ENCRYPTION_KEY_HEX64_AQUI"

# --- OpenAI (default: GPT-4o)
OPENAI_API_KEY="COLE_SUA_OPENAI_API_KEY_AQUI"

# Modelos (opcionais). Se algum modelo não existir, há fallback.
OPENAI_MODEL="gpt-4o"
OPENAI_MODEL_REPLY="gpt-4o"
OPENAI_MODEL_INSIGHTS="gpt-4o"
OPENAI_MODEL_SMART_REPLIES="gpt-4o"
OPENAI_MODEL_FALLBACK="gpt-4o-mini"

# --- WhatsApp Business Cloud API
WHATSAPP_API_BASE_URL="https://graph.facebook.com/v19.0"
WHATSAPP_BUSINESS_PHONE_ID="SEU_WHATSAPP_PHONE_NUMBER_ID_AQUI"
WHATSAPP_ACCESS_TOKEN="SEU_WHATSAPP_ACCESS_TOKEN_AQUI"

# --- Worker de campanhas (Bulk)
CAMPAIGN_MAX_RETRIES=3
CAMPAIGN_DELAY_JITTER=0.25
CAMPAIGN_TICK_INTERVAL_MS=15000

# ============================
# API v2 (/api) - FULL MODE
# ============================
# MongoDB (Mongoose)
MONGO_URI="mongodb://localhost:27017/whatsHybrid"
MONGO_DB_NAME="whatsHybrid"

# JWT
JWT_SECRET="COLE_UMA_CHAVE_BEM_GRANDE_COM_32+_CHARS_AQUI________________"
JWT_REFRESH_SECRET="COLE_OUTRA_CHAVE_BEM_GRANDE_COM_32+_CHARS_AQUI________"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# Redis (opcional, recomendado para filas/rate-limit)
REDIS_URL="redis://localhost:6379"
REDIS_PREFIX="whcrm:"

# Stripe (v2 billing) - opcional
STRIPE_SECRET_KEY="sk_test_COLE_SUA_CHAVE_AQUI"
STRIPE_WEBHOOK_SECRET="whsec_COLE_SUA_CHAVE_AQUI"
STRIPE_PUBLISHABLE_KEY="pk_test_COLE_SUA_CHAVE_AQUI"

# Email (opcional)
EMAIL_PROVIDER="log"  # log|smtp|resend|sendgrid
EMAIL_FROM="no-reply@SEU-DOMINIO.com"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""

# Feature flags
ENABLE_V2=true
ENABLE_AI=true
ENABLE_WEBHOOKS=true
MAINTENANCE_MODE=false

# Logs
LOG_LEVEL=info
LOG_FORMAT=json

# Rate limit
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
